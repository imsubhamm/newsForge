APP_NAME=Bangla News AI Editor
APP_ENV=production
LOG_LEVEL=info
STORAGE_PATH=/opt/newseditor/storage
DATABASE_URL=sqlite:////opt/newseditor/data/news_editor.db
MOCK_AI=true
MOCK_WHISPER=true
AI_PROVIDER=openai
OPENAI_API_KEY=
NEXT_PUBLIC_API_URL=http://127.0.0.1:8010
REMOTION_CONCURRENCY=1
HF_HOME=/opt/newseditor/.cache/huggingface
TMPDIR=/tmp
