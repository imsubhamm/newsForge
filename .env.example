# Application
APP_NAME=Bangla News AI Editor
APP_ENV=development
LOG_LEVEL=info

# Local-first storage (paths are relative to the repository root)
STORAGE_PATH=./storage
DATABASE_URL=sqlite:///./data/news_editor.db

# AI provider abstraction
# Use MOCK_AI=true for UI/video development without API spend.
MOCK_AI=true
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini

# Speech (used from Milestone 3)
WHISPER_MODEL=small
WHISPER_DEVICE=auto
# Keep Hugging Face weights on an internal disk. Flash APFS caches corrupt Whisper models.
HF_HOME=/Users/imsub/.cache/huggingface

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_APP_NAME=Bangla News AI Editor

# Rendering
REMOTION_CONCURRENCY=1
VIDEO_FPS=30
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
DEFAULT_CROP_MODE=center-crop
